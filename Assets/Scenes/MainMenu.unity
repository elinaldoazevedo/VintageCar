      m_Calls: []
  m_text: "No in\xEDcio do s\xE9culo XX, com o crescimento da cidade e o aumento
    do volume de correspond\xEAncias, tornou-se necess\xE1ria a constru\xE7\xE3o
    de um pr\xE9dio dos Correios mais amplo e moderno. Assim, no final da d\xE9cada
    de 1920 ou in\xEDcio da d\xE9cada de 1930, o pr\xE9dio dos Correios em Bel\xE9m
    foi erguido, refletindo os estilos arquitet\xF4nicos da \xE9poca.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
